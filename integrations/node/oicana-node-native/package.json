{
  "name": "@oicana/node-native",
  "version": "0.9.0-rc.2",
  "description": "Native binary for @oicana/node. Install @oicana/node instead.",
  "main": "index.js",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/napi-rs/package-template.git"
  },
  "license": "PolyForm-Noncommercial-1.0.0",
  "browser": "browser.js",
  "keywords": [
    "napi-rs",
    "NAPI",
    "N-API",
    "Rust",
    "node-addon",
    "node-addon-api"
  ],
  "files": [
    "index.d.ts",
    "index.js",
    "browser.js"
  ],
  "napi": {
    "binaryName": "node-native",
    "targets": [
      "x86_64-pc-windows-msvc",
      "x86_64-apple-darwin",
      "x86_64-unknown-linux-gnu",
      "aarch64-unknown-linux-gnu",
      "aarch64-apple-darwin",
      "x86_64-unknown-linux-musl",
      "aarch64-unknown-linux-musl",
      "aarch64-pc-windows-msvc"
    ]
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "scripts": {
    "artifacts": "napi artifacts",
    "bench": "node --import @oxc-node/core/register benchmark/bench.ts",
    "build": "napi build --platform --release",
    "build:debug": "napi build --platform",
    "format": "run-p format:prettier format:rs format:toml",
    "format:prettier": "prettier . -w",
    "format:toml": "taplo format",
    "format:rs": "cargo fmt",
    "format:check": "run-p format:check:prettier format:check:rs format:check:toml",
    "format:check:prettier": "prettier . --check",
    "format:check:toml": "taplo format --check",
    "format:check:rs": "cargo fmt -- --check",
    "lint": "oxlint .",
    "prepublishOnly": "napi prepublish -t npm --no-gh-release",
    "test": "ava",
    "preversion": "napi build --platform && git add .",
    "version": "napi version",
    "napi": "napi"
  },
  "devDependencies": {
    "@emnapi/core": "1.5.0",
    "@emnapi/runtime": "1.5.0",
    "@napi-rs/cli": "3.2.0",
    "@oxc-node/core": "0.0.32",
    "@taplo/cli": "0.7.0",
    "@tybys/wasm-util": "0.10.0",
    "@types/node": "24.6.2",
    "ava": "6.4.1",
    "chalk": "5.6.2",
    "lint-staged": "16.1.6",
    "npm-run-all2": "8.0.4",
    "oxlint": "1.14.0",
    "prettier": "3.6.2",
    "tinybench": "5.0.1",
    "typescript": "5.9.2"
  },
  "lint-staged": {
    "*.@(js|ts|tsx)": [
      "oxlint --fix"
    ],
    "*.@(js|ts|tsx|yml|yaml|md|json)": [
      "prettier --write"
    ],
    "*.toml": [
      "taplo format"
    ]
  },
  "ava": {
    "extensions": {
      "ts": "module"
    },
    "timeout": "2m",
    "workerThreads": false,
    "environmentVariables": {
      "OXC_TSCONFIG_PATH": "./__test__/tsconfig.json"
    },
    "nodeArguments": [
      "--import",
      "@oxc-node/core/register"
    ]
  },
  "prettier": {
    "printWidth": 120,
    "semi": false,
    "trailingComma": "all",
    "singleQuote": true,
    "arrowParens": "always"
  },
  "packageManager": "yarn@4.10.3",
  "optionalDependencies": {
    "@oicana/node-native-darwin-arm64": "0.1.0-alpha.1",
    "@oicana/node-native-darwin-x64": "0.1.0-alpha.1",
    "@oicana/node-native-linux-arm64-gnu": "0.1.0-alpha.1",
    "@oicana/node-native-linux-arm64-musl": "0.1.0-alpha.1",
    "@oicana/node-native-linux-x64-gnu": "0.1.0-alpha.1",
    "@oicana/node-native-win32-arm64-msvc": "0.1.0-alpha.1",
    "@oicana/node-native-win32-x64-msvc": "0.1.0-alpha.1"
  }
}
