{
  "name": "oicana/oicana",
  "description": "Generate typeset PDFs in PHP from Typst templates, in process. No headless browser, no per-document fees.",
  "type": "library",
  "license": "PolyForm-Noncommercial-1.0.0",
  "version": "0.9.0-rc.2",
  "keywords": [
    "oicana",
    "typst",
    "pdf",
    "templating",
    "typesetting"
  ],
  "homepage": "https://oicana.com",
  "authors": [
    {
      "name": "Oicana",
      "email": "hello@oicana.com"
    }
  ],
  "repositories": [
    {
      "type": "path",
      "url": "../oicana-php-installer"
    }
  ],
  "require": {
    "php": "^8.3",
    "oicana/installer": "^0.9.0-rc.2"
  },
  "suggest": {
    "ext-oicana": "Required for PDF generation. Automatically downloaded by oicana-installer"
  },
  "require-dev": {
    "ext-zip": "*",
    "pestphp/pest": "^2.0",
    "phpstan/phpstan": "^1.10",
    "squizlabs/php_codesniffer": "^3.7"
  },
  "autoload": {
    "psr-4": {
      "Oicana\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Oicana\\Tests\\": "tests/"
    }
  },
  "bin": [
    "bin/oicana-env"
  ],
  "scripts": {
    "test": "pest",
    "phpstan": "phpstan analyse src tests --level=8",
    "cs-check": "phpcs",
    "cs-fix": "phpcbf"
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "pestphp/pest-plugin": true,
      "oicana/installer": true
    }
  }
}
